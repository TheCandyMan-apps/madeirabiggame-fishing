{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker name — matches the project on the dashboard
  "name": "madeirabiggame-fishing",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],

  // Serve the Vite build output as static assets.
  // SPA fallback (all routes → index.html) is automatic with not_found_handling.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
